# Clerk Dashboard > API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Server-side only. Set in Vercel for production; never prefix with VITE_.
GEMINI_API_KEY=your_google_ai_api_key

# Judge0 compiler endpoint for Deva's JavaScript, Python, Java, and C++ runner.
# Keep the API key server-side. Use the same values in Flask/.env and Vercel.
# Local Judge0 default (port 2358); set the deployed HTTPS URL in production.
JUDGE0_API_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=

# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

